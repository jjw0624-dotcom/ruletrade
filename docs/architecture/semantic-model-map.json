  },
  "distinctions": [
    {"left":"Asset","right":"AssetSet","rule":"one symbol is not a candidate domain"},
    {"left":"Group","right":"Subgroup/Selection output","rule":"Group is reusable static membership; Selection output is evaluated membership"},
    {"left":"Selection","right":"Allocation","rule":"membership choice never implies capital"},
    {"left":"Buy/Sell","right":"Rebalance","rule":"cash/quantity order semantics are not target weights; Buy/Sell is draft-only"},
    {"left":"Condition fallback","right":"Selection shortage fallback","rule":"control branching and shortage replacement are different nodes"},
    {"left":"Event","right":"State/Memory","rule":"occurrence, durable state and remembered typed value have separate identity"},
    {"left":"evaluation clock","right":"execution clock","rule":"completed observation boundary does not itself schedule allocation"}
  ],
  "known_limits": ["fixed-money and quantity order statements are not Canonical V2 statements", "signals, loops and functions are draft-only", "Program Portfolio is implicit and must not be rendered as a Blockly statement"]
