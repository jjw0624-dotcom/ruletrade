  "roots": [
    {"type":"CanonicalStrategyV2","fields":["api_version","semantic_profile","metadata","definitions","operator_lock","selection","predicate","program"],"persisted":true},
    {"type":"SemanticProgramV2","fields":["semantic_id","clocks","initial_state","formalizations","statements"],"persisted":"inside CanonicalStrategyV2"},
    {"type":"ProgramWorkingDraft","canonical":false,"persisted":"browser localStorage","source":"frontend/src/domain/programWorkingDraft.ts"}
  ],
  "types": {
    "values": ["LiteralValue","CandidateTrailingReturnValue","CandidateCurrentPriceValue","DailyValueNode","CrossSectionalValueV2","ScoreValueV2","CrossSectionalAggregateValueV2","EventRelativeValueV2","ClockedValueV2","RememberedValueV2","BarsSinceEventValueV2","BarsSinceStateValueV2","TimeSinceEventValueV2","TimeSinceStateValueV2"],
    "conditions": ["ComparisonV2","BooleanGroupV2(all/any)","NotConditionV2","StateConditionV2","NOfMConditionV2","EventWindowConditionV2"],
    "statements": ["AllocationStatementV2","SelectionStatementV2","StateTransitionStatementV2","RememberValueStatementV2","EventStatementV2","ConditionalStatementV2","GuardedAllocationStatementV2","UnresolvedStatementV2"],
    "definitions": ["AssetSetDefinitionV2","GroupDefinitionV2","CandidateBinding","SelectionV2","ProgramClockV2","EventDefinitionV2","FormalizationProvenanceV2"],
    "allocation": ["AllocationTargetV2(asset|selection|group|cash|retain)","AllocationLegV2","AllocationStatementV2(equal|fixed|proportional_score|inverse_volatility)","OverrideRuleV2"],
