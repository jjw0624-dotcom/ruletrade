<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RuleTradeGenerated</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LeanRoot Condition="'$(LeanRoot)' == ''">/Lean</LeanRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../build/lean/Main.cs" Link="Main.cs" />
    <Reference Include="QuantConnect.Common">
      <HintPath>$(LeanRoot)/Launcher/bin/Debug/QuantConnect.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="QuantConnect.Algorithm">
      <HintPath>$(LeanRoot)/Launcher/bin/Debug/QuantConnect.Algorithm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Python.Runtime">
      <HintPath>$(LeanRoot)/Launcher/bin/Debug/Python.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
